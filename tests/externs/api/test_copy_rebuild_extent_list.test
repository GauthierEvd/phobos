#
# API copy rebuild with extent list
#

test_bin_dir=$PWD
test_bin="$test_bin_dir/test_copy_rebuild_extent_list"
test_dir=$(dirname $(readlink -e $0))
. $test_dir/test_env.sh
. $test_dir/setup_db.sh
. $test_dir/test_launch_daemon.sh
. $test_dir/utils_generation.sh

function setup
{
    setup_tables
    setup_test_dirs

    INPUT_FILE="$DIR_TEST/file"
    dd if=/dev/urandom of="$INPUT_FILE" bs=1K count=64

    DIRS=(
          $(mktemp -d "$DIR_TEST/test_pho.XXXX")
          $(mktemp -d "$DIR_TEST/test_pho.XXXX")
          $(mktemp -d "$DIR_TEST/test_pho.XXXX")
          $(mktemp -d "$DIR_TEST/test_pho.XXXX")
          $(mktemp -d "$DIR_TEST/test_pho.XXXX")
          $(mktemp -d "$DIR_TEST/test_pho.XXXX")
         )

    invoke_lrs

    $phobos dir add ${DIRS[@]}
    $phobos dir format --unlock ${DIRS[@]}
}

function setup_split
{
    local layout=$1
    local count

    setup_tables
    setup_test_dirs

    INPUT_FILE="$DIR_TEST/file"
    if [[ $layout == "raid1" ]]; then
        count=1025
    else
        count=2049
    fi

    dd if=/dev/urandom of="$INPUT_FILE" bs=1K count=$count

    DIRS=(
          $(make_tmp_fs 1M)
          $(make_tmp_fs 1M)
          $(make_tmp_fs 1M)
          $(make_tmp_fs 1M)
          $(make_tmp_fs 1M)
          $(make_tmp_fs 1M)
          $(make_tmp_fs 1M)
          $(make_tmp_fs 1M)
          $(make_tmp_fs 1M)
         )

    invoke_lrs
    $phobos dir add ${DIRS[@]}
    $phobos dir format --unlock ${DIRS[@]}
}

function cleanup
{
    waive_lrs
    cleanup_test_dirs
    drop_tables
}

function cleanup_split
{
    waive_lrs

    for dir in ${DIRS[@]}; do
        cleanup_tmp_fs "$dir"
    done

    cleanup_test_dirs
    drop_tables
}

function get_extent_info
{
    local oid=$1
    local copy=$2
    local column=$3

    $phobos extent list -f json -o "$column" -c "$copy" "$oid" |
        jq -r ".[0].$column[]"
}

function get_extent
{
    local idx=$1

    $PSQL -t -c "
        SELECT l.extent_uuid
        FROM object o
        JOIN layout l
            ON l.object_uuid = o.object_uuid
            AND l.version = o.version
        WHERE o.oid = 'oid'
            AND l.copy_name = 'source'
            AND l.layout_index = $idx;
    "
}

function test_rebuild_extent_list_raid1
{
    $phobos put -f dir -l raid1 --lyt-params=repl_count=4 $INPUT_FILE oid

    local extents_before=($(get_extent_info oid source ext_uuid))
    local hash_before=($(get_extent_info oid source xxh128))

    waive_lrs
    local media=($(get_extent_info oid source media_name))
    $phobos dir del --lost ${media[0]} ${media[1]}
    invoke_lrs

    $LOG_COMPILER $test_bin oid source 1 2

    local extents_after=($(get_extent_info oid source ext_uuid))
    local hash_after=($(get_extent_info oid source xxh128))
    local count=$($phobos extent list -o ext_count)
    if [[ $count -ne 3 ]]; then
        error "oid should have only 3 extents, got $count"
    fi

    # Extent lyt_index 2 should be different after the rebuild
    if [[ ${extents_after[1]} == ${extents_before[2]} ]]; then
        error "Extent lyt_index 2 should be different after the rebuild"
    fi

    if [[ ${extents_after[2]} != ${extents_before[3]} ]]; then
        error "Extent lyt_index 3 should be the same"
    fi

    if [[ ${hash_after[0]} != ${hash_before[1]} ||
          ${hash_after[1]} != ${hash_before[2]} ]]; then
        error "Rebuilt extents should have the same content"
    fi

    # There should be no extent at lyt_index 0
    local extent_0=$(get_extent 0)
    if [[ ! -z $extent_0 ]]; then
        error "Extent lyt_index 0 shouldn't be rebuilt"
    fi
}

function test_rebuild_extent_list_raid1_split
{
    $phobos put -f dir -l raid1 --lyt-params=repl_count=3 $INPUT_FILE oid

    local extents_before=($(get_extent_info oid source ext_uuid))
    local hash_before=($(get_extent_info oid source xxh128))

    waive_lrs
    local media=($(get_extent_info oid source media_name))
    $phobos dir del --lost ${media[0]} ${media[3]}
    invoke_lrs

    $LOG_COMPILER $test_bin oid source 1

    local extents_after=($(get_extent_info oid source ext_uuid))
    local hash_after=($(get_extent_info oid source xxh128))
    local count=$($phobos extent list -o ext_count)
    if [[ $count -ne 4 ]]; then
        error "oid should have only 4 extents, got $count"
    fi

    if [[ ${extents_after[0]} == ${extents_before[1]} ]]; then
        error "Extent 1 should have be rebuilt"
    fi

    if [[ ${hash_after[0]} != ${hash_before[1]} ]]; then
        error "Rebuilt extent 1 should have the same content"
    fi

    if [[ ! -z $(get_extent 0) && ! -z $(get_extent 3) ]]; then
        error "Extent 0 and 3 shouldn't be rebuilt"
    fi

    $LOG_COMPILER $test_bin oid source 4

    extents_after=($(get_extent_info oid source ext_uuid))
    hash_after=($(get_extent_info oid source xxh128))
    count=$($phobos extent list -o ext_count)
    if [[ $count -ne 4 ]]; then
        error "oid should have only 4 extents, got $count"
    fi

    if [[ ${extents_after[2]} == ${extents_before[4]} ]]; then
        error "Extent 4 should have be rebuilt"
    fi

    if [[ ${hash_after[2]} != ${hash_before[4]} ]]; then
        error "Rebuilt extent 4 should have the same content"
    fi

    if [[ ! -z $(get_extent 0) && ! -z $(get_extent 3) ]]; then
        error "Extent 0 and 3 shouldn't be rebuilt"
    fi

    $LOG_COMPILER $test_bin oid source 2 5

    extents_after=($(get_extent_info oid source ext_uuid))
    hash_after=($(get_extent_info oid source xxh128))
    count=$($phobos extent list -o ext_count)
    if [[ $count -ne 4 ]]; then
        error "oid should have only 4 extents, got $count"
    fi

    if [[ ${extents_after[1]} == ${extents_before[2]} ||
          ${extents_after[3]} == ${extents_before[5]} ]]; then
        error "Extent 2 and 5 should have be rebuilt"
    fi

    if [[ ${hash_after[1]} != ${hash_before[2]} ||
          ${hash_after[3]} != ${hash_before[5]} ]]; then
        error "Rebuilt extent 2 and 5 should have the same content"
    fi

    if [[ ! -z $(get_extent 0) && ! -z $(get_extent 3) ]]; then
        error "Extent 0 and 3 shouldn't be rebuilt"
    fi
}

function test_rebuild_extent_list_raid4
{
    $phobos put -f dir -l raid4 $INPUT_FILE oid2

    local extents_before=($(get_extent_info oid2 source ext_uuid))
    local hash_before=($(get_extent_info oid2 source xxh128))

    $LOG_COMPILER $test_bin oid2 source 1

    local extents_after=($(get_extent_info oid2 source ext_uuid))
    local hash_after=($(get_extent_info oid2 source xxh128))
    local count=$($phobos extent list -o ext_count)
    if [[ $count -ne 3 ]]; then
        error "oid2 should have only 3 extents, got $count"
    fi

    if [[ ${extents_before[0]} != ${extents_after[0]} ||
          ${extents_before[1]} == ${extents_after[1]} ||
          ${extents_before[2]} != ${extents_after[2]} ]]; then
        error "Only extent 1 should be rebuilt"
    fi

    if [[ ${hash_before[1]} != ${hash_after[1]} ]]; then
        error "The content of extent 1 should be the same"
    fi
}

function test_rebuild_extent_list_raid4_split
{
    $phobos put -f dir -l raid4 $INPUT_FILE oid

    local extents_before=($(get_extent_info oid source ext_uuid))
    local hash_before=($(get_extent_info oid source xxh128))

    $LOG_COMPILER $test_bin oid source 1

    local extents_after=($(get_extent_info oid source ext_uuid))
    local hash_after=($(get_extent_info oid source xxh128))
    local count=$($phobos extent list -o ext_count)
    if [[ $count -ne 6 ]]; then
        error "oid should have only 6 extents, got $count"
    fi

    if [[ ${extents_after[1]} == ${extents_before[1]} ]]; then
        error "Extent 1 should have be rebuilt"
    fi

    if [[ ${hash_after[1]} != ${hash_before[1]} ]]; then
        error "Rebuilt extent 1 should have the same content"
    fi

    $LOG_COMPILER $test_bin oid source 4

    extents_after=($(get_extent_info oid source ext_uuid))
    hash_after=($(get_extent_info oid source xxh128))

    if [[ ${extents_after[4]} == ${extents_before[4]} ]]; then
        error "Extent 4 should have be rebuilt"
    fi

    if [[ ${hash_after[4]} != ${hash_before[4]} ]]; then
        error "Rebuilt extent 4 should have the same content"
    fi

    $LOG_COMPILER $test_bin oid source 2 5

    extents_after=($(get_extent_info oid source ext_uuid))
    hash_after=($(get_extent_info oid source xxh128))

    if [[ ${extents_after[2]} == ${extents_before[2]} ||
          ${extents_after[5]} == ${extents_before[5]} ]]; then
        error "Extent 2 and 5 should have be rebuilt"
    fi

    if [[ ${hash_after[2]} != ${hash_before[2]} ||
          ${hash_after[5]} != ${hash_before[5]} ]]; then
        error "Rebuilt extent 2 and 5 should have the same content"
    fi
}

function test_rebuild_extent_list_raid1_invalid
{
    $phobos put -f dir -l raid1 --lyt-params=repl_count=2 $INPUT_FILE oid

    # Check that we cannot ask to rebuild all the extents of a split
    $LOG_COMPILER $test_bin oid source 0 1 && error "rebuild should have failed"
    $LOG_COMPILER $test_bin oid source 2 3 && error "rebuild should have failed"

    waive_lrs
    local media=($(get_extent_info oid source media_name))
    $phobos dir del --lost ${media[0]} ${media[2]}
    invoke_lrs

    # Check that we cannot ask to rebuild the last data extent if we have no
    # parity extents left
    $LOG_COMPILER $test_bin oid source 1 && error "rebuild should have failed"
    $LOG_COMPILER $test_bin oid source 3 && error "rebuild should have failed"

    return 0
}

function test_rebuild_extent_list_raid4_invalid
{
    $phobos put -f dir -l raid4 $INPUT_FILE oid

    # Check that we cannot ask to rebuild all the extents of a split
    $LOG_COMPILER $test_bin oid source 0 1 2 &&
        error "rebuild should have failed"
    $LOG_COMPILER $test_bin oid source 3 4 5 &&
        error "rebuild should have failed"

    waive_lrs
    local media=($(get_extent_info oid source media_name))
    $phobos dir del --lost ${media[0]} ${media[3]}
    invoke_lrs

    # Check that we cannot ask to rebuild one data extent if we have no
    # parity extents left
    $LOG_COMPILER $test_bin oid source 1 && error "rebuild should have failed"
    $LOG_COMPILER $test_bin oid source 1 2 && error "rebuild should have failed"
    $LOG_COMPILER $test_bin oid source 4 && error "rebuild should have failed"
    $LOG_COMPILER $test_bin oid source 4 5 && error "rebuild should have failed"

    return 0
}

function test_rebuild_avoid_extent_to_rebuild
{
    local repl_count
    local layout=$1

    if [[ $layout == "raid1" ]]; then
        $phobos put -f dir -l raid1 --lyt-params=repl_count=2 $INPUT_FILE oid
        repl_count=2
    else
        $phobos put -f dir -l raid4 $INPUT_FILE oid
        repl_count=3
    fi

    for i in $(seq 0 $(($repl_count - 1))); do
        local media=($(get_extent_info oid source media_name))

        # Create an I/O error on the medium where the extent to rebuild is.
        # If this medium is used, the rebuild should failed
        make_tmp_fs_fail_io ${media[$i]}

        $LOG_COMPILER $test_bin oid source $i

        # We delete the medium where the rebuilt extent was to avoid using it
        # for the next rebuild.
        waive_lrs
        $phobos dir del --lost ${media[$i]}
        invoke_lrs
    done
}

TESTS=("setup; \
            test_rebuild_extent_list_raid1; \
            test_rebuild_extent_list_raid4; \
        cleanup"
       "setup_split raid1; \
            test_rebuild_extent_list_raid1_invalid; \
        cleanup_split"
       "setup_split raid4; \
            test_rebuild_extent_list_raid4_invalid; \
        cleanup_split"
       "setup_split raid1; \
            test_rebuild_extent_list_raid1_split; \
        cleanup_split"
       "setup_split raid4; \
            test_rebuild_extent_list_raid4_split; \
        cleanup_split"
       "setup_split raid1; \
            test_rebuild_avoid_extent_to_rebuild raid1; \
        cleanup_split"
       "setup_split raid4; \
            test_rebuild_avoid_extent_to_rebuild raid4; \
        cleanup_split")
